# Copy to .env locally if your tooling loads it (optional).
# Do NOT commit .env — it is gitignored.

# Offline Hugging Face model folders (absolute paths on your machine)
OFFLINE_ONLY=true
LOCAL_LLM_ONLY=true
EMBEDDING_MODEL_LOCAL_PATH=C:\models\all-MiniLM-L6-v2
HF_CHAT_MODEL_LOCAL_PATH=C:\models\qwen2.5-1.5b-instruct
RERANKER_MODEL_LOCAL_PATH=C:\models\ms-marco-MiniLM-L6-v2

# Optional: strict PDF naming convention.
# By default any *.pdf is accepted and document type is inferred from the
# folder under Data/documents/ (e.g. PSS/, PSS/FAQs/). Override these only if
# you want to enforce a specific filename prefix scheme.
# DOC_NAME_PATTERN=^(PSS|FAQ|manual|guide)_[A-Za-z0-9._-]+\.pdf$
# ENFORCE_DOC_NAME_PATTERN=true
