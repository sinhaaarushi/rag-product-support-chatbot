# --- Python ---
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
chatbot_env/

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
# Streamlit's secrets file is the conventional place for credentials; keep
# the hardening config.toml tracked but never commit secrets.toml.
.streamlit/secrets.toml

# --- IDE / OS ---
.idea/
.vscode/
.cursor/
*.swp
Thumbs.db
Desktop.ini

# =============================================================================
# Sensitive / local-only data (by design NOT in GitHub)
# This repo tracks *code and docs*; documents and indexes stay on your machine.
# =============================================================================

# PDFs and any extracted uploads
Data/documents/*
!Data/documents/.gitkeep

# FAISS index + chunk metadata (may contain document text)
Data/vector_store/*
!Data/vector_store/.gitkeep

# Runtime logs (may contain operational details)
Data/logs/

# Local backups of vector store (often zip with metadata)
Data/backups/

# Optional: local model mirrors if placed inside the repo folder (prefer C:\models\ outside repo)
models/
*.faiss

# Personal scratch notes (kept outside the repo on the dev machine)
My_Project_Notes/

# Ad-hoc preflight/rebuild output (regenerated on demand)
smoke_out.txt
rebuild.log
model_download.log

